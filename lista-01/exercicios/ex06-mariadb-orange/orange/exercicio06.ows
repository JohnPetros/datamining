	<node_properties>
		<properties node_id="0" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\xf9\x00\x00\x00\xc3\x00\x00\x05\x8b\x00\x00\x03{\x00\x00\x02\x1f\x00\x00\x00\xfe\x00\x00\x05e\x00\x00\x03U\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x02\x1f\x00\x00\x00\xfe\x00\x00\x05e\x00\x00\x03U', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import pymysql\nfrom Orange.data import Table, Domain, DiscreteVariable, ContinuousVariable\n\nconn = pymysql.connect(\n    host="127.0.0.1",\n    port=3307,\n    user="datamining",\n    password="datamining",\n    database="datamining_ex06"\n)\n\nwith conn.cursor() as cursor:\n    cursor.execute("""\n        SELECT id_cliente, nome_cliente, idade, cidade, estado, renda\n        FROM clientes_problematicos\n        ORDER BY id_cliente\n    """)\n    rows = cursor.fetchall()\n\nconn.close()\n\ndef categorias(posicao):\n    return sorted({\n        str(row[posicao])\n        for row in rows\n        if row[posicao] is not None\n    })\n\ndomain = Domain([\n    DiscreteVariable("id_cliente", values=categorias(0)),\n    DiscreteVariable("nome_cliente", values=categorias(1)),\n    ContinuousVariable("idade"),\n    DiscreteVariable("cidade", values=categorias(3)),\n    DiscreteVariable("estado", values=categorias(4)),\n    ContinuousVariable("renda")\n])\n\ndados = [\n    [\n        str(row[0]) if row[0] is not None else None,\n        str(row[1]) if row[1] is not None else None,\n        float(row[2]) if row[2] is not None else None,\n        str(row[3]) if row[3] is not None else None,\n        str(row[4]) if row[4] is not None else None,\n        float(row[5]) if row[5] is not None else None\n    ]\n    for row in rows\n]\n\nout_data = Table.from_list(domain, dados)', 'filename': None}], 'scriptText': 'import pymysql\nfrom Orange.data import Table, Domain, DiscreteVariable, ContinuousVariable\n\nconn = pymysql.connect(\n    host="127.0.0.1",\n    port=3307,\n    user="datamining",\n    password="datamining",\n    database="datamining_ex06"\n)\n\nwith conn.cursor() as cursor:\n    cursor.execute("""\n        SELECT id_cliente, nome_cliente, idade, cidade, estado, renda\n        FROM clientes_problematicos\n        ORDER BY id_cliente\n    """)\n    rows = cursor.fetchall()\n\nconn.close()\n\ndef categorias(posicao):\n    return sorted({\n        str(row[posicao])\n        for row in rows\n        if row[posicao] is not None\n    })\n\ndomain = Domain([\n    DiscreteVariable("id_cliente", values=categorias(0)),\n    DiscreteVariable("nome_cliente", values=categorias(1)),\n    ContinuousVariable("idade"),\n    DiscreteVariable("cidade", values=categorias(3)),\n    DiscreteVariable("estado", values=categorias(4)),\n    ContinuousVariable("renda")\n])\n\ndados = [\n    [\n        str(row[0]) if row[0] is not None else None,\n        str(row[1]) if row[1] is not None else None,\n        float(row[2]) if row[2] is not None else None,\n        str(row[3]) if row[3] is not None else None,\n        str(row[4]) if row[4] is not None else None,\n        float(row[5]) if row[5] is not None else None\n    ]\n    for row in rows\n]\n\nout_data = Table.from_list(domain, dados)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x01]\x00\x00\x00\xd4\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
