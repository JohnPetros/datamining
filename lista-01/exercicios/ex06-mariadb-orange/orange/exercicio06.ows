		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xe6\xff\xff\xff\xfb\x00\x00\x03x\x00\x00\x02\xb3\x00\x00\x00\x0c\x00\x00\x006\x00\x00\x03R\x00\x00\x02\x8d\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x00\x0c\x00\x00\x006\x00\x00\x03R\x00\x00\x02\x8d', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import pymysql\nfrom Orange.data import Table, Domain, DiscreteVariable, ContinuousVariable\n\nconn = pymysql.connect(\n    host="127.0.0.1",\n    port=3307,\n    user="datamining",\n    password="datamining",\n    database="datamining_ex06"\n)\n\nwith conn.cursor() as cursor:\n    cursor.execute("""\n        SELECT id_produto, nome_produto, categoria, valor_unitario\n        FROM produtos_problematicos\n        ORDER BY id_produto\n    """)\n    rows = cursor.fetchall()\n\nconn.close()\n\ndef categorias(posicao):\n    return sorted({\n        str(row[posicao])\n        for row in rows\n        if row[posicao] is not None\n    })\n\ndomain = Domain([\n    DiscreteVariable("id_produto", values=categorias(0)),\n    DiscreteVariable("nome_produto", values=categorias(1)),\n    DiscreteVariable("categoria", values=categorias(2)),\n    ContinuousVariable("valor_unitario")\n])\n\ndados = [\n    [\n        str(row[0]) if row[0] is not None else None,\n        str(row[1]) if row[1] is not None else None,\n        str(row[2]) if row[2] is not None else None,\n        float(row[3]) if row[3] is not None else None\n    ]\n    for row in rows\n]\n\nout_data = Table.from_list(domain, dados)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xaa\x00\x00\x00f\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="11" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x07\x7f\x00\x00\x04\x07\x00\x00\x00\xee\x00\x00\x00\xd8\x00\x00\x04\r\x00\x00\x02\xcb\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x06\x00\x00\x00\x1b\x00\x00\x07y\x00\x00\x04\x01', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="12" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\xff\x00\x00\x00\xde\x00\x00\x05\x91\x00\x00\x03\x96\x00\x00\x02%\x00\x00\x01\x19\x00\x00\x05k\x00\x00\x03p\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x02%\x00\x00\x01\x19\x00\x00\x05k\x00\x00\x03p', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import pymysql\nfrom Orange.data import Table, Domain, DiscreteVariable, ContinuousVariable\n\nconn = pymysql.connect(\n    host="127.0.0.1",\n    port=3307,\n    user="datamining",\n    password="datamining",\n    database="datamining_ex06"\n)\n\nwith conn.cursor() as cursor:\n    cursor.execute("""\n        SELECT id_venda, data_venda, id_cliente, id_produto,\n               quantidade, valor_unitario, valor_total\n        FROM vendas_problematicas\n        ORDER BY id_venda\n    """)\n    rows = cursor.fetchall()\n\nconn.close()\n\ndef categorias(posicao):\n    return sorted({\n        str(row[posicao])\n        for row in rows\n        if row[posicao] is not None\n    })\n\ndomain = Domain([\n    DiscreteVariable("id_venda", values=categorias(0)),\n    DiscreteVariable("data_venda", values=categorias(1)),\n    DiscreteVariable("id_cliente", values=categorias(2)),\n    DiscreteVariable("id_produto", values=categorias(3)),\n    ContinuousVariable("quantidade"),\n    ContinuousVariable("valor_unitario"),\n    ContinuousVariable("valor_total")\n])\n\ndados = [\n    [\n        str(row[0]) if row[0] is not None else None,\n        str(row[1]) if row[1] is not None else None,\n        str(row[2]) if row[2] is not None else None,\n        str(row[3]) if row[3] is not None else None,\n        float(row[4]) if row[4] is not None else None,\n        float(row[5]) if row[5] is not None else None,\n        float(row[6]) if row[6] is not None else None\n    ]\n    for row in rows\n]\n\nout_data = Table.from_list(domain, dados)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xaa\x00\x00\x00f\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
